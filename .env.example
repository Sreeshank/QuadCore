# Local defaults work without any secrets.
APP_ENV=development
DEMO_MODE=true
# Leave DATABASE_URL unset for SQLite; use postgresql+psycopg:// for PostgreSQL.
# DATABASE_URL=postgresql+psycopg://taxready:change-me@localhost:5432/taxready
STORAGE_BACKEND=local
# STORAGE_DIR=./data/private
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=30
RATE_LIMIT=120
# Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=

# Optional Supabase authentication + PRIVATE storage. Server-only credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=taxready-private

# Optional compatible structured-output LLM. Deterministic extraction works without it.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

